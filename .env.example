# Prefer: python scripts/init_config.py --mode docker
# Never commit .env or replace installed encryption keys.
DOCSYNC_ENV=prod
DOCSYNC_DEBUG=false
WEB_PORT=8090
DOCSYNC_MASTER_KEY=
DOCSYNC_JWT_SECRET=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Compose derives this URL from MYSQL_PASSWORD automatically.
DOCSYNC_META_DB_URL=mysql+asyncmy://docsync:YOUR_PASSWORD@mysql:3306/docsync?charset=utf8mb4
DOCSYNC_DATA_DIR=./data
DOCSYNC_CORS_ORIGINS=[]
DOCSYNC_SCHEDULER_ENABLED=true
DOCSYNC_EMBEDDED_SCHEDULER=true
DOCSYNC_SCHEDULER_TICK_SECONDS=15
DOCSYNC_WORKER_MAX_CONCURRENCY=2
# Internal API port is fixed at 8000 for nginx and health checks.
# Optional: DOCSYNC_BROWSER, DOCSYNC_BROWSER_PROFILES_DIR, DOCSYNC_WPS_DOWNLOAD_DIR
# Optional build argument: PIP_INDEX_URL=https://pypi.org/simple/
