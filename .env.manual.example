# Prefer: python scripts/init_config.py --mode manual
# Run backend commands from backend/. Keep secrets private and stable.
DOCSYNC_ENV=prod
DOCSYNC_DEBUG=false
DOCSYNC_MASTER_KEY=
DOCSYNC_JWT_SECRET=
DOCSYNC_META_DB_URL=sqlite+aiosqlite:///./data/docsync.db
DOCSYNC_DATA_DIR=./data
DOCSYNC_CORS_ORIGINS=[]
DOCSYNC_SCHEDULER_ENABLED=true
DOCSYNC_EMBEDDED_SCHEDULER=true
DOCSYNC_WORKER_MAX_CONCURRENCY=2
# Optional full path to Chromium / Chrome / Edge:
# DOCSYNC_BROWSER=
